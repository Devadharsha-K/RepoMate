# Copy this file to ".env" and fill in real values once we get Bob 2.0 access tonight.
# Never commit the real .env file - it's already in .gitignore.

PORT=3000
BOB_API_URL=
BOB_API_KEY=

# Optional but recommended: a GitHub personal access token (no special scopes
# needed for public repos). Raises GitHub's API rate limit from 60/hour to
# 5000/hour - useful with 4 people testing the repo-explainer at once.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
